# zvena in production: HTTPS (Let's Encrypt, renewed by Caddy) in front of
# the web app and Design. Domains and the ACME e-mail come from .env.
# Access log: client addresses cut to /16 (IPv4) and /32 (IPv6), no cookies,
# tokens or OAuth codes — the log holds no personal data (privacy policy).
#
# Custom domains of published sites (Notion Sites → Custom domain, see
# DEPLOY.md "Custom domains for sites"): any other host name that reaches
# this server gets a certificate on its first HTTPS request — on demand —
# but only when the web app says it is a verified, live site domain (the
# "ask" endpoint answers 200 for those and 404 for everything else, so
# nobody can make Caddy fetch certificates for arbitrary names).
{
	email {$ACME_EMAIL}
	# Behind Cloudflare the TCP peer is a Cloudflare edge: the visitor's address
	# comes from Cf-Connecting-Ip, and only from these ranges
	# (https://www.cloudflare.com/ips), so the log's client_ip is the visitor's,
	# cut to /16 like every address in the log. Without Cloudflare nothing changes.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
	on_demand_tls {
		ask http://web:3100/api/sites/domain-check
	}
}

# Let's Encrypt first; if it can't issue yet (a new DNS record, a CDN in
# front), a certificate from Caddy's own CA keeps the site up meanwhile —
# enough for Cloudflare's "Full" SSL mode — and Caddy tries ACME again.
(certs) {
	tls {
		issuer acme
		issuer internal
	}
}

(log) {
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Forwarded-For delete
			request>headers>X-Real-Ip delete
			request>headers>Cf-Connecting-Ip delete
			request>headers>Cf-Connecting-Ipv6 delete
			request>headers>True-Client-Ip delete
			request>headers>Referer delete
			request>uri query {
				delete code
				delete state
				delete token
				delete device_id
			}
			resp_headers>Set-Cookie delete
			resp_headers>Location delete
		}
	}
}

(zvena) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
	import log
}

{$APP_DOMAIN} {
	import zvena
	# The largest body the web app takes is a 50 MB upload to Documents.
	request_body {
		max_size 60MB
	}
	# Caddy's own question; nobody else needs the answer.
	@ask path /api/sites/domain-check
	respond @ask 404
	reverse_proxy web:3100 {
		header_up X-Real-IP {remote_host}
	}
}

{$DESIGN_DOMAIN} {
	import zvena
	import certs
	request_body {
		max_size 350MB
	}
	reverse_proxy design-frontend:8080 {
		header_up X-Real-IP {remote_host}
	}
}

www.{$APP_DOMAIN} {
	import certs
	redir https://{$APP_DOMAIN}{uri} permanent
}

# Every other host: a site's custom domain (docs.example.com → CNAME
# zv-….sites.example.com). The web app serves the site there and nothing else
# of zvena (src/proxy.ts); here no cookie goes in or out either way, bodies
# are small (published pages are read-only), and HSTS covers the host only
# (the web app sets it, without includeSubDomains — the customer's other
# subdomains are not ours to pin).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
	import log
	request_body {
		max_size 1MB
	}
	@ask path /api/sites/domain-check
	respond @ask 404
	reverse_proxy web:3100 {
		header_up X-Real-IP {remote_host}
		header_up -Cookie
		header_up -Authorization
		header_down -Set-Cookie
	}
}

http:// {
	redir https://{host}{uri} permanent
}
