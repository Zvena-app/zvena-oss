# zvena production settings.
#
# Create the real file with scripts/init-env.sh: it copies this example to
# /etc/zvena/zvena.env (mode 600) and generates every secret itself. The file
# with real values never goes into Git and is never pasted into chats.
#
# Format: KEY=value, no spaces around "=". Quote values that contain spaces
# or < > with double quotes. docker compose and the scripts in scripts/ read
# this file line by line (it is never executed).

# --- Domains and HTTPS -------------------------------------------------------
COMPOSE_PROJECT_NAME=zvena
APP_DOMAIN=example.com
DESIGN_DOMAIN=design.example.com
APP_URL=https://example.com
DESIGN_URL=https://design.example.com
# Let's Encrypt writes to this address about certificates.
ACME_EMAIL=admin@example.com

# --- Secrets (generated by scripts/init-env.sh) ------------------------------
PG_PASSWORD=
AUTH_SECRET=
DESIGN_SECRET_KEY=
DESIGN_MGMT_KEY=
DESIGN_OIDC_CLIENT_ID=zvena-design
DESIGN_OIDC_CLIENT_SECRET=
ZVENA_INTERNAL_KEY=

# --- Images (written by scripts/build-images.sh or load-images.sh) ----------
WEB_IMAGE=
DESIGN_BACKEND_IMAGE=
DESIGN_FRONTEND_IMAGE=

# --- Sign-in ------------------------------------------------------------------
# Each method appears on the sign-in page only when its keys are set.
#
# Google (OAuth 2.0 + One Tap): Google Cloud console → APIs & Services →
#   Credentials → OAuth client ID → "Web application".
#   Authorized JavaScript origins: https://example.com
#   Authorized redirect URIs:      https://example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App.
#   Homepage URL:               https://example.com
#   Authorization callback URL: https://example.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- E-mail (Resend) ------------------------------------------------------------
# Sign-in links, moderation notes and monitoring alerts go through Resend
# (https://resend.com). Verify the sending domain in Resend first (DNS
# records), then create an API key with "Sending access".
# Without a key there is no e-mail sign-in.
RESEND_API_KEY=
MAIL_FROM="zvena <hello@example.com>"
# Alternative to Resend: any SMTP server (used only when RESEND_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Operator (who runs this server) ----------------------------------------
# Shown in the footer, Help, the Cookie Policy and security.txt.
ZVENA_COMPANY_NAME=
# Main contact (default: admin@<APP_DOMAIN>).
ZVENA_CONTACT_EMAIL=admin@example.com
# Help with using zvena only (default: the contact address).
ZVENA_SUPPORT_EMAIL=
# Optional separate inboxes (default: the contact address).
ZVENA_PRIVACY_EMAIL=
ZVENA_ABUSE_EMAIL=
# Your own Terms of Service and Privacy Policy (https://…). /legal/terms and
# /legal/privacy send people there; zvena ships no legal text of its own.
ZVENA_TERMS_URL=
ZVENA_PRIVACY_URL=
# Where people get the source of the version you run (GNU AGPL 3.0, section 13).
# Point it at your own repository if you change zvena.
ZVENA_SOURCE_URL=https://github.com/Zvena-app/zvena-oss
# The Terms/Privacy Policy version (a date). Change it whenever their text
# changes: signed-in people are then asked to accept the new version.
ZVENA_CONSENT_VERSION=2026-10-15

# --- Moderation -----------------------------------------------------------------
# Moderator account ids, comma-separated (see scripts/make-admin.sh), and the
# address that receives new reports.
ZVENA_ADMIN_IDS=
ZVENA_ADMIN_EMAIL=

# --- Limits ---------------------------------------------------------------------
# Storage per account (bytes, default 2 GB).
ZVENA_STORAGE_QUOTA_BYTES=2147483648
# People editing one doc at the same time: 0 = no limit. If set, at least 3.
ZVENA_MAX_EDITORS_PER_DOC=0
# Members per workspace: 0 = no limit.
ZVENA_MAX_MEMBERS=0
# Guest uploads are deleted after this many days without a visit
# (a banner warns guests about it).
ZVENA_GUEST_FILE_TTL_DAYS=30
# Longest side of uploaded images after compression (px).
ZVENA_IMAGE_MAX_SIDE=2560
ZVENA_INVITE_DAYS=14
# Uploads are refused when the disk has less free space than this (bytes).
ZVENA_MIN_FREE_BYTES=1073741824

# --- Decisions: Jev (TypeSafe AI) -------------------------------------------
# Empty key = Jev is off everywhere: suggestions and reactions ("when → if →
# then") run on rules only and nothing is sent to TypeSafe AI.
# With a key, Jev works in every workspace whose owner has not turned it off
# (Projects → Settings → Assistant). What is sent, and when: /legal/privacy#jev.
# Fields that name a person (assignee, person, e-mail and phone columns) are
# never sent.
TYPESAFE_API_KEY=
# A workspace whose owner never chose: on (default) or off (opt-in: nothing is
# sent until the owner turns Jev on). Update /legal/privacy#jev when changing it.
ZVENA_JEV_DEFAULT=on
ZVENA_JEV_MODEL=jev-latest
ZVENA_JEV_TIMEOUT_MS=1500

# --- Container resources (sized for 4 vCPU / 8 GB) ------------------------------
DESIGN_JAVA_OPTS="-Xms256m -Xmx1g -XX:+UseG1GC -XX:MaxMetaspaceSize=320m"
DESIGN_BACKEND_MEM=1536m
DESIGN_EXPORTER_MEM=1g
PG_MEM=1g
WEB_MEM=768m

# Extra Penpot flags for Design, added to those in docker-compose.yml (the bridge
# to Docs and Projects, enable-zvena-bridge, is already there). Empty unless you
# need one; deploy/scripts refuse disable-secure-session-cookies in production.
DESIGN_EXTRA_FLAGS=

# --- Design files in S3 (optional, docker-compose.s3.yml) -----------------------
# Any S3-compatible storage. Keep it in the same region as the servers
# (and where your Privacy Policy says the data is stored).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Backups (scripts/backup.sh) --------------------------------------------------
BACKUP_DIR=/var/backups/zvena
# File with the encryption passphrase (created by init-env.sh). Keep a copy of
# the passphrase away from the server: without it backups cannot be restored.
BACKUP_PASSPHRASE_FILE=/etc/zvena/backup.pass
BACKUP_KEEP_DAYS=14
# Off-site copy (one or both):
#   rsync over SSH — user@backup-host:/srv/zvena-backups
#   rclone         — remote-name:bucket/folder (rclone config on this server)
BACKUP_RSYNC_TARGET=
BACKUP_RCLONE_REMOTE=

# --- Monitoring (scripts/monitor.sh) ----------------------------------------------
# Alerts about outages go here (through Resend or SMTP above).
ALERT_EMAIL=

# --- Documents ---------------------------------------------------------------
# Time zone of scheduled automations and repeating templates (a workspace can
# set its own; reminders follow each person's browser zone).
ZVENA_TZ=UTC
# Map view and Place property: tiles and address search go through the server
# (browsers never call the map hosts). Empty = OpenStreetMap's public servers,
# which require a contact (e-mail or URL) in the requests and suit light use;
# for heavy use run your own tile server or a provider and set its URLs.
ZVENA_TILES_URL=
ZVENA_GEOCODER_URL=
ZVENA_MAPS_CONTACT=
# Page history: everything newer than this many days is kept; per-workspace cap.
ZVENA_VERSIONS_KEEP_DAYS=30
ZVENA_VERSIONS_WORKSPACE_BYTES=268435456

# --- Phone apps (clients/mobile) ----------------------------------------------
# Links to zvena open in the iOS and Android apps once the stores' apps are
# signed: /.well-known/apple-app-site-association lists ZVENA_IOS_APP_ID
# ("TEAMID.app.zvena.mobile", comma-separated), /.well-known/assetlinks.json
# the Android package and its signing certificates' SHA-256 fingerprints
# (Play Console → App integrity, comma-separated). Empty: both answer 404.
ZVENA_IOS_APP_ID=
ZVENA_ANDROID_PACKAGE=app.zvena.mobile
ZVENA_ANDROID_CERT_SHA256=

# --- Sites on custom domains (DEPLOY.md, section 17) ---------------------------
# Customers point their domain here (a CNAME to zv-<claim>.<this name>); this
# name and *.<this name> are A records to the server, not proxied by Cloudflare.
ZVENA_SITES_CNAME=sites.example.com
# Other host names that are zvena itself (comma-separated), besides APP_URL's.
ZVENA_APP_HOSTS=
# "off" serves the app under any host name again (no custom domains).
ZVENA_SITES_HOST_ROUTING=on
# "on" offers custom domains in Settings → Sites, and only once Caddy's
# on_demand_tls (deploy/caddy/Caddyfile) and the DNS for ZVENA_SITES_CNAME are
# live; off (the default): no section, the routes and Caddy's ask answer 404.
ZVENA_SITES_CUSTOM_DOMAINS=off

# --- Mail ----------------------------------------------------------------------
# People's own mailboxes over IMAP/SMTP (passwords sealed with a key derived
# from AUTH_SECRET: changing AUTH_SECRET asks everyone for their app password
# again). One sync worker per mailbox runs inside the web process; "off" stops
# them (and the outbox clock). Mail kept: this many days per folder, at most
# this many messages a folder, texts fetched in the background for this many
# days, and this many bytes of text per person (older texts are fetched again
# when opened); files waiting in drafts per person.
ZVENA_MAIL_SYNC=on
ZVENA_MAIL_SYNC_DAYS=90
ZVENA_MAIL_MAX_PER_FOLDER=2000
ZVENA_MAIL_BODY_DAYS=30
ZVENA_MAIL_BODY_QUOTA_BYTES=536870912
ZVENA_MAIL_UPLOADS_BYTES=209715200
# Bytes of mail a person may have waiting in the outbox (send later, undo send).
ZVENA_MAIL_OUTBOX_BYTES=209715200
