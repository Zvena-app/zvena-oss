<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push: Xcode signs store builds with "production" from the provisioning profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links, verified against <APP_URL>/.well-known/apple-app-site-association.
	     The host is written by scripts/prepare.cjs from APP_URL (committed with the placeholder zvena.example.com). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:zvena.example.com</string>
	</array>
	<!-- Shared with the share extension (items it hands over). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.zvena.mobile</string>
	</array>
</dict>
</plist>
