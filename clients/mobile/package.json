{
  "name": "zvena-mobile",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "zvena for iOS and Android: Capacitor shells around the zvena web app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "sync": "node scripts/prepare.cjs && cap sync",
    "sync:android": "node scripts/prepare.cjs && cap sync android",
    "sync:ios": "node scripts/prepare.cjs && cap sync ios",
    "android:debug": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run sync:android && cd android && ./gradlew bundleRelease",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
