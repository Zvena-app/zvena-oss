{
  "name": "zvena-desktop",
  "productName": "zvena",
  "version": "1.0.0",
  "description": "zvena for desktop: docs, projects and design in one window.",
  "author": {
    "name": "zvena",
    "email": "hi@zvena.app"
  },
  "homepage": "https://github.com/Zvena-app/zvena-oss",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "src/main.js",
  "desktopName": "zvena.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/icons.mjs",
    "dist": "electron-builder --config electron-builder.config.js",
    "dist:linux": "electron-builder --config electron-builder.config.js --linux AppImage deb",
    "dist:mac": "electron-builder --config electron-builder.config.js --mac dmg",
    "dist:win": "electron-builder --config electron-builder.config.js --win nsis"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  }
}
